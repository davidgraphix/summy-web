# Copy to `.env.local` for development. Never commit real values.

# --- API origin, WITHOUT the /api/v1 suffix (the client appends it) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5080

# --- Public site origin, no trailing slash ---
# Drives metadataBase, Open Graph URLs and the admin SEO preview host.
# Deliberately unset until the Mega Dealers domain is purchased: a guessed
# value would silently produce wrong canonical/OG URLs. The app degrades to
# relative metadata and a neutral preview placeholder while it is empty.
NEXT_PUBLIC_SITE_URL=

# --- Cloudinary cloud name (public; used to build delivery URLs) ---
# This is the Cloudinary ACCOUNT name, not branding. Changing it breaks every
# existing product image URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=summy
