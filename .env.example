# Base origin of the ASP.NET Core API. The client appends /api/v1 automatically.
NEXT_PUBLIC_API_BASE_URL=https://api.summysolutions.com

# Optional dev-only reverse proxy target to avoid CORS (used by next.config rewrites).
# API_PROXY_TARGET=https://api.summysolutions.com

# Public Cloudinary cloud name (only if building upload widgets client-side).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=summy
